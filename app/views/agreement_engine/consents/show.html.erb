<div class="max-w-4xl mx-auto p-4 my-8 lg:my-24">
  <article class="prose prose-gray dark:prose-invert max-w-none">
    <%= drawn_document(@version.frozen_copy["document"], values: @version.frozen_copy["values"]) %>
  </article>

  <div class="mt-8 sm:mt-16 text-center">
    <p><%= t(".statement") %></p>
    <div class="mt-4 flex items-center justify-center gap-2">
      <%= button_to t(".consent"), agreement_engine.consent_path, method: :post, class: "btn btn-primary btn-large" %>
    </div>
  </div>
</div>
