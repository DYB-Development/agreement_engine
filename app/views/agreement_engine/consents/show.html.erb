<div class="max-w-4xl mx-auto p-4 my-8 lg:my-24">
  <article class="prose prose-gray dark:prose-invert max-w-none">
    <%= render "agreement_engine/documents/issued_version", document: @version %>
  </article>

  <div class="mt-8 sm:mt-16 text-center">
    <% if AgreementEngine.config.current_user(controller).held_consent %>
      <p><%= t(".held") %></p>
      <div class="mt-4 flex items-center justify-center gap-2">
        <%= button_to t(".withdraw"), agreement_engine.consent_path, method: :delete, class: "btn btn-secondary btn-large" %>
      </div>
    <% else %>
      <p><%= t(".statement") %></p>
      <div class="mt-4 flex items-center justify-center gap-2">
        <%= ui_form(action: agreement_engine.consent_path, method: :post) do %>
          <%= ui_button(label: t(".consent")) %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
