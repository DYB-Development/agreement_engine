<div class="mx-auto max-w-4xl px-4 py-8">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold"><%= @document.document_type.titleize %> v<%= @document.version %></h1>
    <div class="flex gap-2">
      <%= link_to "Edit", agreement_engine.edit_admin_document_path(@document), class: "btn btn-secondary" %>
      <%= link_to "Back", agreement_engine.admin_documents_path, class: "btn btn-secondary" %>
    </div>
  </div>

  <dl class="grid grid-cols-2 gap-4 mb-6">
    <div>
      <dt class="text-sm font-medium text-gray-500">Status</dt>
      <dd><%= @document.published? ? "Published" : "Draft" %></dd>
    </div>
    <div>
      <dt class="text-sm font-medium text-gray-500">Effective Date</dt>
      <dd><%= @document.effective_at&.strftime("%B %d, %Y") || "Not set" %></dd>
    </div>
    <% if @document.content_hash %>
      <div class="col-span-2">
        <dt class="text-sm font-medium text-gray-500">Issued from page</dt>
        <dd><%= @document.frozen_copy["slug"] %>, version <%= @document.frozen_copy["number"] %></dd>
      </div>
      <div class="col-span-2">
        <dt class="text-sm font-medium text-gray-500">SHA-256</dt>
        <dd class="font-mono break-all"><%= @document.content_hash %></dd>
      </div>
    <% end %>
    <% if @document.summary.present? %>
      <div class="col-span-2">
        <dt class="text-sm font-medium text-gray-500">Summary</dt>
        <dd><%= @document.summary %></dd>
      </div>
    <% end %>
  </dl>

  <article class="prose prose-gray dark:prose-invert max-w-none">
    <% if @document.content_hash %>
      <%= drawn_document(@document.frozen_copy["document"], values: @document.frozen_copy["values"]) %>
    <% else %>
      <%= @document.content %>
    <% end %>
  </article>

  <h2 class="text-xl font-bold mt-10 mb-4">Acceptances</h2>
  <% if @document.acceptances.any? %>
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200 text-sm">
        <thead>
          <tr>
            <th class="px-3 py-2 text-left font-medium text-gray-500">Accepted</th>
            <th class="px-3 py-2 text-left font-medium text-gray-500">Person</th>
            <th class="px-3 py-2 text-left font-medium text-gray-500">Account</th>
            <th class="px-3 py-2 text-left font-medium text-gray-500">IP address</th>
            <th class="px-3 py-2 text-left font-medium text-gray-500">Browser</th>
            <th class="px-3 py-2 text-left font-medium text-gray-500">Signed in with</th>
            <th class="px-3 py-2 text-left font-medium text-gray-500">Hash</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200">
          <% @document.acceptances.each do |acceptance| %>
            <tr>
              <td class="px-3 py-2"><%= acceptance.accepted_at&.strftime("%B %d, %Y %H:%M %Z") %></td>
              <td class="px-3 py-2"><%= acceptance.person.to_h.values_at("name", "email").compact.join(", ") %></td>
              <td class="px-3 py-2"><%= acceptance.account.to_h["name"] %></td>
              <td class="px-3 py-2"><%= acceptance.ip_address %></td>
              <td class="px-3 py-2"><%= acceptance.user_agent %></td>
              <td class="px-3 py-2"><%= Array(acceptance.sign_in.to_h["methods"]).join(", ") %></td>
              <td class="px-3 py-2 font-mono break-all"><%= acceptance.content_hash %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="text-gray-500">No one has accepted this version yet.</p>
  <% end %>
</div>
