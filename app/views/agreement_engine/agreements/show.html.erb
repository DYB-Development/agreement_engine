<div class="max-w-4xl mx-auto p-4 my-8 lg:my-24">
  <%= ui_heading(text: t(".title", agreement: @agreement.title), size: :lg) %>

  <% if @version %>
    <%= ui_caption(text: t(".last_updated", date: l(@version.effective_at.to_date, format: :long)), normal_case: true) %>

    <% if (period = AgreementEngine::Period.describe(@version.frozen_copy.to_h["period"])) %>
      <%= ui_paragraph(text: "Period: #{period}") %>
    <% end %>
    <%= ui_reading_hold(**reading_hold_options, waiting: t(".waiting"), ready: t(".ready")) do |hold| %>
      <% hold.with_action do %>
        <% if @error %>
          <%= ui_alert(message: @error, type: :error) %>
        <% end %>
        <%= ui_paragraph(text: t(".description", agreement: @agreement.title)) %>
        <%= ui_form(action: agreement_engine.agreement_path(@agreement), method: :patch) do %>
          <%= ui_button(label: t(".accept"), data: {reading_hold_target: "button"}) %>
        <% end %>
      <% end %>
      <article class="prose prose-gray dark:prose-invert max-w-none">
        <%= render "agreement_engine/documents/issued_version", document: @version %>
      </article>
    <% end %>
  <% else %>
    <p class="text-gray-500">No version has been published yet.</p>
  <% end %>

  <div class="mt-8 sm:mt-16">
    <div class="mt-4 flex items-center justify-center gap-2">
      <%= ui_form(action: agreement_engine.agreement_path(@agreement), method: :delete) do %>
        <%= ui_button(label: t(".decline"), variant: :secondary) %>
      <% end %>
    </div>
  </div>
</div>
