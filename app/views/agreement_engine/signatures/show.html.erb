<div class="max-w-4xl mx-auto p-4 my-8 lg:my-24">
  <h1 class="mb-4"><%= @type.title %></h1>

  <article class="prose prose-gray dark:prose-invert max-w-none">
    <%= drawn_document(@version.frozen_copy["document"], values: @version.frozen_copy["values"]) %>
  </article>

  <%= form_with(scope: :signature, url: form_url, method: :patch, class: "mt-8 sm:mt-16 space-y-4") do |form| %>
    <% if @error %>
      <div class="bg-red-50 border border-red-200 rounded p-4 text-red-700"><%= @error %></div>
    <% end %>

    <% if @type.signature? %>
      <p><%= t("agreement_engine.signatures.show.statement", document: @type.title) %></p>

      <div>
        <%= form.label :typed_name, t("agreement_engine.signatures.show.typed_name"), class: "block text-sm font-medium text-gray-700" %>
        <%= form.text_field :typed_name, autocomplete: "name", class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm" %>
      </div>

      <div>
        <%= form.submit t("agreement_engine.signatures.show.sign"), class: "btn btn-primary btn-large" %>
      </div>
    <% else %>
      <p><%= t("agreement_engine.record_documents.show.statement", document: @type.title) %></p>

      <div>
        <%= form.submit t("agreement_engine.record_documents.show.accept"), class: "btn btn-primary btn-large" %>
      </div>
    <% end %>
  <% end %>
</div>
