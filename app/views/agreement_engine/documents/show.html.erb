<% content_for :title, @type.title %>

<div class="mx-auto max-w-4xl px-4 py-12 sm:px-6 lg:px-8">
  <article class="prose prose-gray dark:prose-invert max-w-none">
    <h1><%= @type.title %></h1>

    <% if @version %>
      <p class="text-sm text-gray-500 dark:text-gray-400">
        Version <%= @version.version %> - Effective <%= @version.effective_at.strftime("%B %d, %Y") %>
      </p>
      <%= render "agreement_engine/documents/issued_version", document: @version %>
    <% else %>
      <p class="text-gray-500"><%= t(".none.#{@type.key}", default: t(".none.default")) %></p>
    <% end %>
  </article>
</div>
